# Скопируйте этот файл в .env и впишите свой ключ. Файл .env никогда не попадает в git.

# Какая модель: openai (OpenAI-совместимый API: модель ОНСОФТ, YandexGPT, Ollama) | gigachat
LLM_PROVIDER=openai

# --- Модель ОНСОФТ на хакатоне (основная): Qwen 3.8 27B, ключ до 10.11.2026 12:00 МСК ---
OPENAI_BASE_URL=https://ai.on-soft.ru/v1
OPENAI_API_KEY=вставьте_сюда_ключ_sk
OPENAI_MODEL=qwen3-6-practice
# модель рассуждает перед ответом, поэтому оставляем запас токенов на ответ
LLM_MAX_TOKENS=6000
# Итоговый режим — С рассуждениями (строка ниже закомментирована). Запасной быстрый режим без рассуждений
# (в 6 раз быстрее, на наших замерах тоже 100) — раскомментировать, если сервер в день защиты перегружен:
# OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- GigaChat (подключение поддерживается, замеров на нём не делали; developers.sber.ru → GigaChat API → «Ключ авторизации») ---
GIGACHAT_AUTH_KEY=вставьте_сюда_ключ_авторизации
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 (Lite), GigaChat-2-Pro, GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2-Max
# Если ошибка CERTIFICATE_VERIFY_FAILED: положите сертификат Минцифры в certs/ и укажите путь
# GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer

# Отключить рассуждения модели (быстрее, но может быть менее точно) — пробуем замером:
# OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

LLM_TEMPERATURE=0.1
